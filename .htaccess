# Page introuvable personnalisée pour l’hébergement PHP Apache (IONOS).
# Le site est installé à la racine du domaine.
ErrorDocument 404 /404.php

# Adresses standard des fichiers SEO, générés depuis config/site.php.
RewriteEngine On
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
